# Versiones fijadas de la red Fabric de SecureQR-ID (ADR-0017, issue #82). Nunca «latest».
# Cambiarlas es una decisión: se prueba con `probar-persistencia.sh` antes de usarlas.
FABRIC_VERSION=2.5.16
FABRIC_CA_VERSION=1.5.22
# fabric-samples no publica etiquetas por versión de parche: se fija el commit de la
# test-network que se probó con estas versiones (2026-09-18).
FABRIC_SAMPLES_COMMIT=5789681b4f4d24e58fa40f19a69f5496892374b6
# Canal y nombre del contrato que usa anchor/ (SQRID_FABRIC_CHANNEL, SQRID_FABRIC_CHAINCODE).
CANAL=secureqr
CONTRATO=secureqr-anclaje
CONTRATO_VERSION=1.0
