{
  "name": "registro-qr",
  "version": "0.1.5",
  "private": true,
  "main": "main.js",
  "homepage": "./",
  "description": "Una aplicación de escritorio para el registro por medio de lectura de codigo QR",
  "author": "Jhunier Libardo Hernandez Calderon",
  "dependencies": {
    "node-fetch": "^2.6.1",
    "selfsigned": "^2.4.1",
    "sudo-prompt": "^9.2.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron-dev": "electron .",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "prepare:server-prod-deps": "npm --prefix server ci --omit=dev",
    "rebuild:native": "node scripts/rebuild-native.js",
    "prepack": "npm run build:server && npm run build:client && npm run prepare:server-prod-deps && npm run rebuild:native",
    "electron-pack": "electron-builder",
    "dist": "npm run prepack && npm run electron-pack"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.4",
    "autoprefixer": "^10.4.19",
    "electron": "^30.0.9",
    "electron-builder": "^24.13.3",
    "framer-motion": "^12.23.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "recharts": "^2.12.7",
    "tailwindcss": "^3.4.3"
  },
  "build": {
    "appId": "com.jhunielibardo.registroqr",
    "productName": "Registro QR",
    "copyright": "Copyright © 2025 Jhunier Libardo Hernandez Calderon",
    "files": [
      "main.js",
      "preload.js",
      "public/favicon.ico",
      "src/lib/**/*"
    ],
    "extraResources": [
      { "from": "server/dist", "to": "server/dist" },
      { "from": "server/package.json", "to": "server/package.json" },
      { "from": "server/node_modules", "to": "server/node_modules" },
      { "from": "client/dist", "to": "client/dist" }
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist",
      "app": "."
    },
    "win": {
      "target": "nsis",
      "icon": "public/favicon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "extraMetadata": {
      "main": "main.js"
    }
  }
}
