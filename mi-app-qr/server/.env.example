PORT=4000
SESSION_SECRET=reemplaza-esto-por-un-valor-aleatorio-largo
# 32 bytes en hexadecimal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Respáldala aparte de la base: sin ella el historial cid → titular no se puede verificar.
ASIGNACIONES_KEY=
DB_PATH=./data/app.db
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=cambia-esto-en-el-primer-inicio-de-sesion
REVOCADOS_EXPORT_PATH=./data/revocados.txt
SITE_TIME_ZONE=America/Bogota
# Altas del portal del titular permitidas por IP y hora (issue #120). Por defecto, 10.
ALTA_MAX_POR_IP=10
# Servicio local de emisión de issuer/ (issue #85). Solo 127.0.0.1 o [::1].
ISSUER_SERVICE_URL=http://127.0.0.1:8765
# El mismo archivo que usa `secureqr-issuer serve` (lo crea `secureqr-issuer generate-secret`).
SQRID_ISSUER_SECRET_FILE=
# Compromiso externo del historial cid → titular (issue #119): la cabeza que lee
# `evidence-log cycle --head-file` y los compromisos que deja `--commitments-file`.
ASIGNACIONES_CABEZA_PATH=./data/anclaje/cabeza-asignaciones.json
ASIGNACIONES_COMPROMISOS_PATH=./data/anclaje/compromisos.json
